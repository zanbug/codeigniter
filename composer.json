{
    "name": "zanbug/codeigniter",
    "description": "Zanbug error & monitoring SDK — CodeIgniter 3 & 4 adapter.",
    "type": "library",
    "keywords": [
        "zanbug",
        "error-monitoring",
        "codeigniter",
        "error-tracking",
        "monitoring",
        "exceptions"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Zanbug",
            "email": "dev@zanbug.com"
        }
    ],
    "require": {
        "php": ">=7.0",
        "zanbug/php-sdk": "^2.0.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-sdk"
        }
    ],
    "autoload": {
        "psr-4": {
            "Zanbug\\CodeIgniter\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://zanbug.com",
    "support": {
        "issues": "https://github.com/zanbug/codeigniter/issues",
        "docs": "https://zanbug.com/integrations/codeigniter",
        "source": "https://github.com/zanbug/codeigniter"
    }
}
